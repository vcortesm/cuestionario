                },
                { //27
                    texto: "Las operaciones tácticas de contraguerrilla urbana se clasifican (591) en ofensivas, de reacción y ________.",
                    opciones: ["preventivas", "precautorias", "previsoras", "precavidas"],
                    correcta: 0
                },
                { //28
                    texto: "Las operaciones ofensivas (592) se caracterizan por el empleo de unidades militares con el propósito específico de destruir a las guerrillas urbanas ________.",
                    opciones: ["enemigas", "adversarias", "contrarias", "opositoras"],
                    correcta: 0
                },
                { //29
                    texto: "En operaciones ofensivas (593), debido a la presencia de la población civil, no se podrá emplear todo el volumen y ________ de fuegos disponibles.",
                    opciones: ["potencia", "poder", "capacidad", "intensidad"],
                    correcta: 0
                },
                { //30
                    texto: "El primer paso de una operación ofensiva (594-A) es ________ el área sospechosa con tropas y fuerzas de seguridad pública.",
                    opciones: ["cercar", "rodear", "circundar", "bloquear"],
                    correcta: 0
                },
                { //31
                    texto: "Se debe informar a la población civil cercada (594-B) la hora en que será atacada el área, a menos que los guerrilleros entreguen sus ________ y se rindan.",
                    opciones: ["armas", "fusiles", "armamento", "pertrechos"],
                    correcta: 0
                },
                { //32
                    texto: "En los puestos de revisión (594-C) se debe contar con personal capacitado para verificar los documentos oficiales de ________ y evitar falsificaciones.",
                    opciones: ["identificación", "identidad", "filiación", "personalidad"],
                    correcta: 0
                },
                { //33
                    texto: "La prioridad para salir por los puestos de revisión (594-C-b) es: primero mujeres, niñas y niños; segundo ________ mayores de 50 años.",
                    opciones: ["hombres", "varones", "caballeros", "personas"],
                    correcta: 0
                },
                { //34
                    texto: "El siguiente paso (594-D) es dividir el área cercada en ________ delimitados por calles específicas.",
                    opciones: ["sectores", "segmentos", "fragmentos", "porciones"],
                    correcta: 0
                },
                { //35
                    texto: "Una vez evacuada la población civil, se procede a ________ al área cercada (594-E).",
                    opciones: ["entrar", "ingresar", "penetrar", "introducirse"],
                    correcta: 0
                },
                { //36
                    texto: "Se recomienda el empleo de tiradores selectos y equipos de búsqueda auxiliados por ________ canófilos (594-E-b).",
                    opciones: ["binomios", "parejas", "dúos", "equipos"],
                    correcta: 0
                },
                { //37
                    texto: "Se debe mantener estrecha vigilancia sobre túneles subterráneos de desagüe o del transporte subterráneo, ya que podrían ser utilizados como vías de ________.",
                    opciones: ["escape", "huida", "fuga", "salida"],
                    correcta: 0
                },
                { //38
                    texto: "Las acciones dentro de los sectores (594-E-d) serán eminentemente ofensivas, empleando al máximo el fuego y ________.",
                    opciones: ["movimiento", "desplazamiento", "maniobra", "avance"],
                    correcta: 0
                },
                { //39
                    texto: "Se debe dar prioridad a la ________ de personal guerrillero en lugar de eliminarlo, debido a la importancia de obtener información (594-E-f).",
                    opciones: ["captura", "aprehensión", "detención", "apresamiento"],
                    correcta: 0
                },
                { //40
                    texto: "La búsqueda de ________ y estaciones de radio clandestinas debe ser uno de los objetivos de la operación (594-E-g).",
                    opciones: ["depósitos", "almacenes", "bodegas", "arsenales"],
                    correcta: 0
                },
                { //41
                    texto: "El desconocimiento del lugar y hora de ataque por parte de las guerrillas obliga a mantener fuerzas de ________ altamente móviles (595).",
                    opciones: ["reacción", "respuesta", "réplica", "contestación"],
                    correcta: 0
                },
                { //42
                    texto: "La ubicación de las fuerzas de reacción (596) se basará en el análisis de las posibilidades del enemigo y en la ________ de los probables objetivos.",
                    opciones: ["retitubabilidad", "vulnerabilidad", "exposición", "fragilidad"],
                    correcta: 0
                },
                { //43
                    texto: "Las fuerzas de reacción terrestres (598) deben contar con equipo adecuado para eliminar ________.",
                    opciones: ["barricadas", "obstáculos", "bloqueos", "barreras"],
                    correcta: 0
                },
                { //44
                    texto: "Las operaciones preventivas (599) tienen como finalidad reducir al máximo las ________ de las guerrillas para realizar cualquier acción exitosamente.",
                    opciones: ["posibilidades", "capacidades", "oportunidades", "probabilidades"],
                    correcta: 0
                },
                { //45
                    texto: "La realización de operaciones preventivas (600) se debe coordinar y apoyar fundamentalmente en las medidas tomadas para el control de la población ________.",
                    opciones: ["civil", "ciudadana", "urbana", "local"],
                    correcta: 0
                },
                { //46
                    texto: "El patrullaje preventivo (601) podrá ser terrestre o ________.",
                    opciones: ["aéreo", "aerotransportado", "volante", "de vigilancia aérea"],
                    correcta: 0
                },
                { //47
                    texto: "Las medidas de reubicación dejarán zonas de la ciudad completamente deshabitadas, las cuales serán señaladas como zonas ________ (602).",
                    opciones: ["prohibidas", "vedadas", "restringidas", "excluidas"],
                    correcta: 0
                },
                { //48
                    texto: "El párrafo 603 menciona que los ________ son una de las acciones más redituables para la guerrilla urbana enemiga.",
                    opciones: ["secuestros", "plagios", "raptos", "capturas"],
                    correcta: 0
                },
                { //49
                    texto: "Los puestos de control y revisión (604-A) tienen por objeto exigir el cumplimiento de las medidas de control en las entradas, ________ y áreas específicas.",
                    opciones: ["salidas", "egresos", "evacuaciones", "desalojos"],
                    correcta: 0
                },
                { //50
                    texto: "La intercepción de comunicaciones (605-A) se realiza mediante el empleo de ________ complementados con analistas de tráfico.",
                    opciones: ["escuchas", "auditores", "vigías", "radioescuchas"],
                    correcta: 0
                }
            ];

            // Mezclar preguntas (orden aleatorio cada carga)
            function mezclarArray(array) {
                for (let i = array.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [array[i], array[j]] = [array[j], array[i]];
                }
                return array;
            }

            const preguntasMezcladas = mezclarArray([...preguntas]);

            // Renderizar
            const contenedor = document.getElementById('contenedor-preguntas');
            let html = '';
            preguntasMezcladas.forEach((p, index) => {
                html += `<div class="pregunta" id="p-${index}">`;
                html += `<span class="num-pregunta">${index + 1}.</span> `;
                html += `<span class="texto-pregunta">${p.texto}</span>`;
                html += `<div class="opciones">`;

                // Mezclar opciones para cada pregunta
                const opcionesConIndice = p.opciones.map((texto, optIdx) => ({ texto, optIdx }));
                const opcionesMezcladas = mezclarArray([...opcionesConIndice]);

                opcionesMezcladas.forEach((opcion, optIndex) => {
                    const radioId = `q${index}_opt${optIndex}`;
                    html += `<div class="opcion-item" data-qidx="${index}" data-oidx="${opcion.optIdx}" data-correcta="${p.correcta}">`;
                    html += `<input type="radio" name="q${index}" value="${opcion.optIdx}" id="${radioId}">`;
                    html += `<label for="${radioId}">${String.fromCharCode(97 + optIndex)}) ${opcion.texto}</label>`;
                    html += `</div>`;
                });

                html += `</div></div>`;
            });
            contenedor.innerHTML = html;

            // Lógica de calificación con realce
            const calificarBtn = document.getElementById('calificarBtn');
            const borrarBtn = document.getElementById('borrarBtn');
            const resultadoDiv = document.getElementById('resultado');

            function quitarClases() {
                document.querySelectorAll('.opcion-item').forEach(item => {
                    item.classList.remove('correcta', 'incorrecta', 'marcada-correcta');
                });
            }

            function calificar() {
                quitarClases();
                let correctas = 0;
                
                for (let i = 0; i < preguntasMezcladas.length; i++) {
                    const radios = document.getElementsByName(`q${i}`);
                    let seleccion = null;
                    let seleccionElement = null;
                    
                    // Encontrar la opción seleccionada y su valor
                    for (let radio of radios) {
                        if (radio.checked) {
                            seleccion = radio.value;
                            seleccionElement = radio.closest('.opcion-item');
                            break;
                        }
                    }
                    
                    const correctaIndex = preguntasMezcladas[i].correcta;
                    
                    // Marcar TODAS las opciones correctas (suele haber una sola)
                    document.querySelectorAll(`.opcion-item[data-qidx="${i}"]`).forEach(item => {
                        if (parseInt(item.dataset.oidx) === correctaIndex) {
                            item.classList.add('correcta');
                        }
                    });
                    
                    // Si hay selección
                    if (seleccion !== null) {
                        if (parseInt(seleccion) === correctaIndex) {
                            correctas++;
                        } else {
                            // La opción incorrecta seleccionada se marca como incorrecta
                            if (seleccionElement) {
                                seleccionElement.classList.add('incorrecta');
                            }
                            // La correcta ya se marcó arriba con 'correcta'
                        }
                    } else {
                        // No seleccionó nada: la correcta se marca igual para que la vea
                        // (ya se marcó en el paso anterior)
                    }
                }
                
                resultadoDiv.style.display = 'block';
                resultadoDiv.innerHTML = `✅ ACIERTOS: ${correctas} de ${preguntasMezcladas.length}  (${Math.round((correctas / preguntasMezcladas.length) * 100)}%)`;
            }

            function borrarTodo() {
                quitarClases();
                for (let i = 0; i < preguntasMezcladas.length; i++) {
                    const radios = document.getElementsByName(`q${i}`);
                    for (let radio of radios) {
                        radio.checked = false;
                    }
                }
                resultadoDiv.style.display = 'none';
            }

            calificarBtn.addEventListener('click', calificar);
            borrarBtn.addEventListener('click', borrarTodo);
        })();
    </script>
</body>
</html>
