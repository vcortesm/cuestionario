    <script>
        (function() {
            // ---------- 50 PREGUNTAS DE COMPLETAR (OPCIONES MUY SIMILARES) ----------
            const preguntas = [
                { //1
                    texto: "El párrafo 565 indica que las operaciones de contraguerrilla urbana comprenden dos formas interrelacionadas: operaciones para controlar a la población civil y operaciones ________ de contraguerrilla urbana.",
